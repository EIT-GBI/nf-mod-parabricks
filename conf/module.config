// Container for the parabricks module processes.
//
// Consuming pipelines pick this up with:
//     includeConfig 'modules/parabricks/conf/module.config'
//
// It deliberately carries no manifest{} block: including one would overwrite
// the consuming pipeline's own manifest, silently dropping its name, version
// and nextflowVersion floor.
//
// The image is NVIDIA's, not built by this repo, so its tag is not
// bumped with the module version.
process {
    withName: 'PARABRICKS_.*' {
        container = 'nvcr.io/nvidia/clara/clara-parabricks:4.7.1-1'
    }
}
